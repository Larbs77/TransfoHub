# =============================================================================
# TransfoHub — Configuration du menu d'administration (PRODUCTION)
# Fichier : config.env
#
# IMPORTANT :
#  - Éditez TOUTES les valeurs avant le premier usage sur le serveur.
#  - Ne commitez pas ce fichier s'il contient des secrets (il n'en contient
#    normalement pas : les secrets restent dans APP_DIR/.env).
#  - Chemins ABSOLUS recommandés.
# =============================================================================

# --- Application -------------------------------------------------------------
# Répertoire d'installation de TransfoHub (clone git / build Next.js)
APP_DIR="/var/www/transfohub"

# Nom du process PM2
PM2_NAME="transfohub"

# Port d'écoute Next.js (doit correspondre à nginx proxy_pass)
APP_PORT="7000"

# --- Git ---------------------------------------------------------------------
# Remote et branche par défaut pour le menu « Déployer depuis Git »
GIT_REMOTE="origin"
GIT_BRANCH="main"

# URL ZIP GitHub (option « télécharger » du menu 5)
# Exemple branche main :
GITHUB_ZIP_URL="https://github.com/Larbs77/TransfoHub/archive/refs/heads/main.zip"
# Exemple tag/release :
# GITHUB_ZIP_URL="https://github.com/Larbs77/TransfoHub/archive/refs/tags/v0.4.0.zip"

# --- Sauvegardes (source + DB) -----------------------------------------------
# Dossier des backups. Par défaut : sous-dossier "backups" à côté de ce pack.
# Vous pouvez pointer ailleurs, ex. /var/backups/transfohub
# Laissez vide pour utiliser automatiquement <dossier_du_pack>/backups
BACKUP_ROOT=""

# Nombre maximum de sauvegardes conservées (rotation automatique)
MAX_BACKUPS="10"

# --- Journal -----------------------------------------------------------------
# Fichier de log des actions admin. Vide = <dossier_du_pack>/transfohub-admin.log
LOG_FILE=""

# --- Nginx / services (noms systemd) -----------------------------------------
NGINX_SERVICE="nginx"

# Arrêter aussi Nginx sur « Tout arrêter » ? (yes/no)
STOP_NGINX_ON_STOP="yes"

# --- Base de données ---------------------------------------------------------
# La DATABASE_URL est lue depuis ${APP_DIR}/.env (recommandé).
# Ne mettez PAS le mot de passe ici.
#
# Optionnel : forcer une URL de dump (sinon lecture auto de APP_DIR/.env)
# DATABASE_URL_OVERRIDE="postgresql://user:pass@127.0.0.1:5432/transfodb"

# --- Outils (chemins absolus si non dans le PATH) -----------------------------
# Laissez vide pour utiliser ceux du PATH (pg_dump, psql, npm, pm2, git, ...)
CMD_PG_DUMP=""
CMD_PSQL=""
CMD_NPM=""
CMD_PM2=""
CMD_GIT=""
CMD_CURL=""
CMD_RSYNC=""
CMD_TAR=""
CMD_UNZIP=""
