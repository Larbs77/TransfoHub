# =============================================================================
# TransfoHub — PRODUCTION BANQUE — console admin (user admin_keba, sans root)
# Domaine : https://transfohub.eurafric.com
# =============================================================================

ENV_NAME="production"
PUBLIC_HOST="transfohub.eurafric.com"
PUBLIC_URL="https://transfohub.eurafric.com"

APP_DIR="/home/admin_keba/workspace/Transfohub-main"

PM2_NAME="transfohub"
# (plus de PM2_USER / sudo — tout s'exécute en tant que l'utilisateur courant)

APP_PORT="8000"

BACKUP_ROOT="/home/admin_keba/backups"
MAX_BACKUPS="15"

GIT_REMOTE_DEFAULT="origin"
GIT_BRANCH_DEFAULT="main"
GITHUB_ZIP_DEFAULT="https://github.com/Larbs77/TransfoHub/archive/refs/heads/main.zip"
# Vide = <dossier du script>/releases
RELEASES_DIR=""

LOG_FILE="/home/admin_keba/backups/transfohub-prod-admin.log"

# Optionnel : forcer les binaires nvm si auto-détection échoue
# CMD_PM2="/home/admin_keba/.nvm/versions/node/v22.x.x/bin/pm2"
# CMD_NPM="/home/admin_keba/.nvm/versions/node/v22.x.x/bin/npm"
# CMD_NODE="/home/admin_keba/.nvm/versions/node/v22.x.x/bin/node"
