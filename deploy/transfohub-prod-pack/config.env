# =============================================================================
# TransfoHub — PRODUCTION BANQUE — configuration du menu d'admin
# Calqué sur le serveur cloud (/root/scripts/transfohub-admin.sh)
#
# Valeurs CLOUD (référence, ne pas utiliser en banque) :
#   APP_DIR=/var/www/transfohub
#   PM2_NAME=transfohub
#   APP_PORT=7000
#   Domaine nginx: transfohub.cloud
#   BACKUP_ROOT=/root/backups/transfohub
#
# À COMPLÉTER pour la production banque (chemins réels du serveur BELRAPSS…) :
# =============================================================================

# Identité
ENV_NAME="production"
PUBLIC_HOST="transfohub.eurafric.com"
PUBLIC_URL="https://transfohub.eurafric.com"

# Application (prod banque — chemin fourni ; retiré le suffixe accidentel "APP_DIR")
APP_DIR="/home/admin_keba/workspace/Transfohub-main"

# PM2 — tourne sous admin_keba (daemon dans /home/admin_keba/.pm2)
# Si pm2 list est vide en root : toujours utiliser :
#   sudo -u admin_keba -H pm2 list
PM2_NAME="transfohub"
# Forcer l'exécution PM2 sous cet utilisateur (évite daemon root vs user)
PM2_USER="admin_keba"

# Port Next.js derrière Nginx
APP_PORT="8000"

# Sauvegardes
BACKUP_ROOT="/home/admin_keba/backups"
MAX_BACKUPS="15"

# Git / ZIP
GIT_REMOTE_DEFAULT="origin"
GIT_BRANCH_DEFAULT="main"
GITHUB_ZIP_DEFAULT="https://github.com/Larbs77/TransfoHub/archive/refs/heads/main.zip"
# Dossier recommandé pour déposer les ZIP de release sur le serveur
RELEASES_DIR=""

# Logs
LOG_FILE="/home/admin_keba/backups/transfohub-prod-admin.log"

# Nginx
NGINX_SERVICE="nginx"
# Arrêter Nginx sur menu « Tout arrêter » ? (cloud = yes ; en banque souvent no)
STOP_NGINX_ON_STOP="no"

# Outils (vides = auto-détection PATH + home utilisateur)
# CMD_PM2=""
# CMD_NPM=""
# CMD_NODE=""
