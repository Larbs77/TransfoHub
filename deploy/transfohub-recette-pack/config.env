# =============================================================================
# TransfoHub RECETTE — paramètres par défaut
# Domaine public : https://transfohub-recette.eurafric.com  (NE PAS CHANGER)
#
# Le chemin de l'app actuelle et le nom PM2 sont DEMANDÉS en interactif
# au lancement de install-recette.sh (pas besoin de les remplir ici).
# =============================================================================

ENV_NAME="recette"
PUBLIC_HOST="transfohub-recette.eurafric.com"
PUBLIC_URL="https://transfohub-recette.eurafric.com"

# Racine des plateformes : chaque déploiement = releases/YYYYMMDD_HHMMSS
# + symlink « current »
PLATFORMS_ROOT="/var/www/transfohub-recette"

# Port Next.js local (proposé par défaut ; modifiable en CLI)
APP_PORT="3000"

# Nginx
NGINX_SERVICE="nginx"
NGINX_SITE_NAME="transfohub-recette"
NGINX_SITES_AVAILABLE="/etc/nginx/sites-available"
NGINX_SITES_ENABLED="/etc/nginx/sites-enabled"

# Certificats (vides = détection auto ; sinon chemins absolus)
SSL_CERT_FILE=""
SSL_KEY_FILE=""
REQUIRE_SSL="true"
FORCE_HTTPS="true"

# Dossier ZIP (relatif au pack si vide → <pack>/releases)
RELEASES_DIR=""

# Téléchargement GitHub auto (false recommandé en banque)
ALLOW_GITHUB_DOWNLOAD="false"
GITHUB_ZIP_URL="https://github.com/Larbs77/TransfoHub/archive/refs/heads/main.zip"

# Backups / logs (vides = sous le pack)
BACKUP_ROOT=""
MAX_BACKUPS="15"
LOG_FILE=""

# DB
RUN_DB_MIGRATE="true"
# Seed toujours interdit dans le script

# Paquets
INSTALL_SYSTEM_PACKAGES="true"
INSTALL_NODE_IF_MISSING="true"
NODE_MAJOR_MIN="20"
