# =============================================================================
# TransfoHub — PRODUCTION BANQUE — console d'administration
# Domaine : https://transfohub.eurafric.com
# =============================================================================

ENV_NAME="production"
PUBLIC_HOST="transfohub.eurafric.com"
PUBLIC_URL="https://transfohub.eurafric.com"

# Application
APP_DIR="/home/admin_keba/workspace/Transfohub-main"

# PM2 (daemon : /home/admin_keba/.pm2)
PM2_NAME="transfohub"
PM2_USER="admin_keba"

# Port derrière Nginx
APP_PORT="8000"

# Sauvegardes
BACKUP_ROOT="/home/admin_keba/backups"
MAX_BACKUPS="15"

# Git / ZIP
GIT_REMOTE_DEFAULT="origin"
GIT_BRANCH_DEFAULT="main"
GITHUB_ZIP_DEFAULT="https://github.com/Larbs77/TransfoHub/archive/refs/heads/main.zip"
# Vide = dossier releases/ à côté de ce script
RELEASES_DIR=""

# Logs
LOG_FILE="/home/admin_keba/backups/transfohub-prod-admin.log"

# Nginx (ne pas arrêter Nginx sur menu 1)
NGINX_SERVICE="nginx"
STOP_NGINX_ON_STOP="no"
